rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isOwner(groupId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId
          == request.auth.uid;
    }

    function isBeneficiary(groupId, roundId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/rounds/$(roundId))
        && get(/databases/$(database)/documents/groups/$(groupId)/rounds/$(roundId)).data.groupId
          == groupId
        && get(/databases/$(database)/documents/groups/$(groupId)/rounds/$(roundId)).data.recipientId
          == request.auth.uid;
    }

    function validMember(data, groupId, memberId) {
      return data.keys().hasAll(['userId', 'groupId', 'joinedAt'])
        && data.keys().hasOnly(['userId', 'groupId', 'joinedAt'])
        && data.userId == memberId
        && data.groupId == groupId;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['phoneNumber', 'displayName', 'createdAt'])
        && request.resource.data.keys().hasOnly(['phoneNumber', 'displayName', 'createdAt']);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      allow get: if isMember(groupId);
      allow list: if isSignedIn()
        && request.auth.uid in resource.data.memberIds;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'name', 'amount', 'currency', 'frequency', 'distributionMode', 'ownerId', 'memberIds', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'amount', 'currency', 'frequency', 'distributionMode', 'ownerId', 'memberIds', 'createdAt'
        ])
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.currency == 'XOF'
        && request.resource.data.frequency in ['daily', 'weekly', 'monthly']
        && request.resource.data.distributionMode in ['tirage', 'ordre'];
      allow update: if isOwner(groupId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.keys().hasAll([
          'name', 'amount', 'currency', 'frequency', 'distributionMode', 'ownerId', 'memberIds', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'amount', 'currency', 'frequency', 'distributionMode', 'ownerId', 'memberIds', 'createdAt'
        ]);
      allow delete: if isOwner(groupId);

      match /members/{memberId} {
        allow get, list: if isMember(groupId);
        allow create: if isSignedIn()
          && validMember(request.resource.data, groupId, memberId)
          && (isOwner(groupId)
            || (memberId == request.auth.uid
              && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.ownerId
                == request.auth.uid));
        allow update: if false;
        allow delete: if isOwner(groupId);
      }

      match /rounds/{roundId} {
        allow get, list: if isMember(groupId);
        allow create, update, delete: if false;
      }

      match /contributions/{contributionId} {
        allow get, list: if isMember(groupId);
        allow create: if isMember(groupId)
          && request.resource.data.keys().hasAll([
            'groupId', 'roundId', 'memberId', 'amount', 'status', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'groupId', 'roundId', 'memberId', 'amount', 'status', 'createdAt'
          ])
          && request.resource.data.groupId == groupId
          && request.resource.data.memberId == request.auth.uid
          && request.resource.data.status == 'declare'
          && exists(/databases/$(database)/documents/groups/$(groupId)/rounds/$(request.resource.data.roundId))
          && get(/databases/$(database)/documents/groups/$(groupId)/rounds/$(request.resource.data.roundId)).data.groupId
            == groupId;
        allow update: if isMember(groupId)
          && resource.data.groupId == groupId
          && resource.data.memberId != request.auth.uid
          && resource.data.status == 'declare'
          && request.resource.data.status == 'confirme'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && isBeneficiary(groupId, resource.data.roundId);
        allow delete: if false;
      }

      match /transactions/{transactionId} {
        allow create: if isMember(groupId);
        allow get, list, update, delete: if false;
      }
    }
  }
}